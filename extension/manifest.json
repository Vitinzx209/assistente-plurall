{
  "manifest_version": 3,
  "name": "Plurall — Assistente Local",
  "version": "1.22.16",
  "description": "Assistente local com conta, ativação de licença e painel branco e roxo.",
  "key": "",
  "permissions": ["storage"],
  "host_permissions": [
    "http://localhost:11434/*",
    "http://127.0.0.1:11434/*",
    "http://127.0.0.1:8765/*",
    "http://penguin.linux.test:11434/*",
    "https://*.plurall.net/*",
    "https://plurall-licencas.slaybvitor.chatgpt.site/*",
    "https://*.supabase.co/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["https://atividades.plurall.net/*"],
      "js": ["license-gate.js", "flow-core.js", "content.js", "queue.js"],
      "run_at": "document_idle"
    }
  ]
}












